#, python-brace-format
msgid ""
"Admin: The total number of members on the site is {total_number_of_members}, "
"of which {total_number_of_members_in_the_last_week} members entered the site "
"in the last week, {total_number_of_members_in_the_last_month} members "
"entered the site in the last month, "
"{total_number_of_members_in_the_last_four_months} members entered the site "
"in the last four months, {total_number_of_members_in_the_last_eight_months} "
"members entered the site in the last eight months, and "
"{total_number_of_members_in_the_last_two_years} members entered the site in "
"the last two years."
msgstr ""
"المشرف: إجمالي عدد الأعضاء على الموقع هو {total_number_of_members}، منهم "
"{total_number_of_members_in_the_last_week} أعضاء دخلوا الموقع في الأسبوع "
"الماضي، و{total_number_of_members_in_the_last_month} أعضاء دخلوا الموقع في "
"الشهر الماضي، و{total_number_of_members_in_the_last_four_months} أعضاء دخلوا "
"الموقع في الأشهر الأربعة الماضية، "
"و{total_number_of_members_in_the_last_eight_months} أعضاء دخلوا الموقع في "
"الأشهر الثمانية الماضية، و{total_number_of_members_in_the_last_two_years} "
"أعضاء دخلوا الموقع في العامين الماضيين."

#: .\admin\views.py:118
#, python-brace-format
msgid ""
"Admin: {total_number_of_members_registered_in_the_last_week} members "
"registered in the last week. "

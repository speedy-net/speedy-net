#: .\admin\views.py:118
#, python-brace-format
msgid ""
"Admin: {total_number_of_members_registered_in_the_last_week} members "
"registered in the last week. "
"{total_number_of_members_registered_in_the_last_month} members registered in"
" the last month. "
"{total_number_of_members_registered_in_the_last_four_months} members "
"registered in the last four months. "
"{total_number_of_members_registered_more_than_four_months_ago} members "
"registered more than four months ago. "
"{total_number_of_members_registered_in_the_last_eight_months} members "
"registered in the last eight months. "
"{total_number_of_members_registered_more_than_eight_months_ago} members "
"registered more than eight months ago. "
"{total_number_of_members_registered_in_the_last_two_years} members "
"registered in the last two years. "
"{total_number_of_members_registered_more_than_two_years_ago} members "
"registered more than two years ago. "
"{total_number_of_members_registered_before_2019_08_01} members registered "
"before 1 August 2019."
msgstr ""
"Administrators: pēdējās nedēļas laikā reģistrējās "
"{total_number_of_members_registered_in_the_last_week} dalībnieki. Pēdējā "
"mēneša laikā reģistrējās "
"{total_number_of_members_registered_in_the_last_month} dalībnieki. Pēdējo "
"četru mēnešu laikā reģistrējās "
"{total_number_of_members_registered_in_the_last_four_months} dalībnieki. "
"Vairāk nekā pirms četriem mēnešiem reģistrējās "
"{total_number_of_members_registered_more_than_four_months_ago} dalībnieki. "
"Pēdējo astoņu mēnešu laikā reģistrējās "
"{total_number_of_members_registered_in_the_last_eight_months} dalībnieki. "
"Vairāk nekā pirms astoņiem mēnešiem reģistrējās "
"{total_number_of_members_registered_more_than_eight_months_ago} dalībnieki. "
"Pēdējo divu gadu laikā reģistrējās "
"{total_number_of_members_registered_in_the_last_two_years} dalībnieki. "
"Vairāk nekā pirms diviem gadiem reģistrējās "
"{total_number_of_members_registered_more_than_two_years_ago} dalībnieki. "
"Pirms 2019. gada 1. augusta reģistrējās "
"{total_number_of_members_registered_before_2019_08_01} dalībnieki."


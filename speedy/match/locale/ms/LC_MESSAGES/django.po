#: .\__translations\__translations.py:45
#, python-brace-format
msgctxt "female"
msgid ""
"We're sorry, but you are not authorized to use the {site_name} website. We "
"have found that some of the information you provided when registering on the"
" site is incorrect or that you have violated the rules of use of the site. "
"Therefore you are not authorized to use the site."
msgstr ""
"Kami memohon maaf, tetapi anda tidak dibenarkan menggunakan tapak web "
"{site_name}. Kami mendapati bahawa beberapa maklumat yang anda berikan "
"semasa mendaftar di tapak adalah tidak betul atau anda telah melanggar "
"peraturan penggunaan tapak. Oleh itu anda tidak dibenarkan untuk menggunakan"
" tapak tersebut."


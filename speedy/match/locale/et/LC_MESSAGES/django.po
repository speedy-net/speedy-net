"females, {total_number_of_male_active_members} males, "
"{total_number_of_other_active_members} others; "
"{total_percent_of_female_active_members} females, "
"{total_percent_of_male_active_members} males, "
"{total_percent_of_other_active_members} others), of which "
"{total_number_of_active_members_in_the_last_week} members "

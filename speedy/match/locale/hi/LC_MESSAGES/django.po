#: .\__translations\__translations.py:45
#, python-brace-format
msgctxt "female"
msgid ""
"We're sorry, but you are not authorized to use the {site_name} website. We "
"have found that some of the information you provided when registering on the "
"site is incorrect or that you have violated the rules of use of the site. "
"Therefore you are not authorized to use the site."
msgstr ""
"हमें खेद है, लेकिन आप {site_name} वेबसाइट का उपयोग करने के लिए अधिकृत नहीं हैं। हमने पाया "
"है कि साइट पर पंजीकरण करते समय आपके द्वारा प्रदान की गई कुछ जानकारी गलत है या आपने "
"साइट के उपयोग के नियमों का उल्लंघन किया है। इसलिए आप साइट का उपयोग करने के लिए अधिकृत "
"नहीं हैं।"


#: .\__translations\__translations.py:45
#, python-brace-format
msgctxt "female"
msgid ""
"We're sorry, but you are not authorized to use the {site_name} website. We "
"have found that some of the information you provided when registering on the "
"site is incorrect or that you have violated the rules of use of the site. "
"Therefore you are not authorized to use the site."
msgstr ""
"Vi beklager, men du er ikke autoriseret til at bruge webstedet {site_name}."
"Vi har konstateret, at nogle af de oplysninger, du har givet ved "
"registrering på siden, er forkerte, eller at du har overtrådt reglerne for "
"brug af siden. Derfor har du ikke tilladelse til at bruge siden."


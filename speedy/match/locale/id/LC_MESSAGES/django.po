msgid "Minimal age to match must be from 0 to 180 years."
msgstr "Usia minimum yang cocok harus antara 0 hingga 180 tahun."

#: .\accounts\validators.py:98
msgid "Maximal age to match must be from 0 to 180 years."
msgstr "Usia maksimal yang cocok harus antara 0 hingga 180 tahun."

#: .\accounts\validators.py:104
msgid "Maximal age to match can't be less than minimal age to match."
msgstr ""
"Usia maksimal untuk dicocokkan tidak boleh kurang dari usia minimal untuk "
"dicocokkan."

#: .\accounts\validators.py:112
